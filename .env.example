# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Administrator Numeric Telegram User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Primary Owner Numeric Telegram User ID
OWNER_ID=123456789

# Database path
DATABASE_PATH=data/abel_promotion.db

# Default language (en or am)
DEFAULT_LANGUAGE=en

# Support contact handle / notification channel if any
SUPPORT_CHANNEL=@AbelPromotionSupport
